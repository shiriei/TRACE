# TRACE - Environment Configuration Template
# Duplicate this file to .env for local overrides (never commit real .env files)

# Backend Host & Port
TRACE_HOST=127.0.0.1
TRACE_PORT=8000
TRACE_ENVIRONMENT=development

# CORS Allowed Origins (Comma-separated)
TRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local AI / LM Studio Settings (Phase 2: Local Gemma 3 4B)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=google/gemma-3-4b
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_TIMEOUT_SECONDS=30.0

# Persistence Configuration (SQLite)
TRACE_DATABASE_PATH=runtime/traces.db

# Media Storage Configuration
TRACE_MEDIA_DIR=runtime/media
TRACE_MAX_UPLOAD_SIZE_BYTES=15728640
