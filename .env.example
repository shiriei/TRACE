# TRACE - Environment Configuration Template
# Duplicate this file to .env for local overrides (never commit real .env files)

# Backend Host & Port
TRACE_HOST=127.0.0.1
TRACE_PORT=8000
TRACE_ENVIRONMENT=development

# CORS Allowed Origins (Comma-separated)
TRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

