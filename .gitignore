# ==============================================================================
# TRACE - Phase 0 Foundation .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Junk
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# IDEs and Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ------------------------------------------------------------------------------
# Environment and Local Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# Node.js and Frontend
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
dist-ssr/
build/
.vite/
*.local

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
venv.bak/

# ------------------------------------------------------------------------------
# Testing, Coverage & Linters
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ------------------------------------------------------------------------------
# Runtime, Logs & Local Databases
# ------------------------------------------------------------------------------
*.log
logs/
*.pid
runtime/
media/
temp/
tmp/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# ------------------------------------------------------------------------------
# AI, Model Weights & LM Studio Local Artifacts
# ------------------------------------------------------------------------------
# Model weights and binaries (never commit to source control)
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx

# LM Studio & local runtime caches
.lmstudio/
lmstudio-models/
cache/
cache/models/

# Vector / embedding indices
*.faiss
*.chroma
*.index
embeddings/
indexes/
